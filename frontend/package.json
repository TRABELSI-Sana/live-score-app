{
  "name": "livefoot-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:seo": "ng build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "watch": "ng build --watch --configuration development",
    "preview": "node scripts/preview.mjs",
    "test:smoke": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "typescript": "~6.0.0",
    "puppeteer": "^25.3.0",
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "angular-eslint": "^22.6.0",
    "globals": "^16.5.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  }
}
